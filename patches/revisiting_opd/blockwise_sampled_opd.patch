+def validate_block_opd_compatibility(
+    block_size: int = 1,
+    loss_mode: str = "vanilla",
+    use_full_kl: bool = False,
+):
+    """Reject settings where block OPD would silently not test sampled block scoring."""
+    block_size = int(block_size or 1)
+    if block_size <= 1:
+        return
+    if loss_mode != "vanilla":
+        raise ValueError("Block OPD currently supports only vanilla PPO policy loss, not GSPO.")
+    if use_full_kl:
+        raise ValueError(
+            "Block OPD currently implements sampled block reverse-KL, not full/top-k KL. "
+            "Use algorithm.adv_estimator=opd with actor_rollout_ref.actor.use_kl_loss=False "
+            "for block OPD variants, and keep full/top-k KL as a separate baseline."
+        )
+
+
+def aggregate_blockwise_policy_inputs(
+    old_log_prob: torch.Tensor,
+    log_prob: torch.Tensor,
+    advantages: torch.Tensor,
+    response_mask: torch.Tensor,
+    block_size: int = 1,
+    block_advantage_mode: str = "sum",
+    block_mix_lambda: float = 0.5,
+):
+    """Aggregate token-level sampled OPD terms into contiguous block-level actions.
+
+    For a block B, the behavior/current log-probabilities are summed over valid
+    tokens so the PPO ratio is computed at block level:
+        r_B = exp(sum_t log pi_theta(y_t) - sum_t log pi_old(y_t)).
+
+    The block advantage is built from token advantages inside the same block.
+    ``sum`` is the naive sampled block reverse-KL estimator; ``mean`` keeps the
+    signal scale close to token OPD; ``mixed`` interpolates between them.
+    """
+    block_size = int(block_size or 1)
+    if block_size <= 1:
+        return old_log_prob, log_prob, advantages, response_mask
+    if block_advantage_mode not in {"sum", "mean", "mixed"}:
+        raise ValueError("block_advantage_mode must be one of: sum, mean, mixed")
+    if not 0.0 <= float(block_mix_lambda) <= 1.0:
+        raise ValueError("block_mix_lambda must satisfy 0 <= lambda <= 1")
+
+    mask = response_mask.to(dtype=old_log_prob.dtype)
+    valid = mask.bool()
+    old_log_prob = torch.where(valid, old_log_prob, torch.zeros_like(old_log_prob))
+    log_prob = torch.where(valid, log_prob, torch.zeros_like(log_prob))
+    advantages = torch.where(valid, advantages, torch.zeros_like(advantages))
+
+    old_blocks = _pad_last_dim_to_multiple(old_log_prob * mask, block_size).reshape(
+        old_log_prob.size(0), -1, block_size
+    )
+    log_blocks = _pad_last_dim_to_multiple(log_prob * mask, block_size).reshape(
+        log_prob.size(0), -1, block_size
+    )
+    adv_blocks = _pad_last_dim_to_multiple(advantages * mask, block_size).reshape(
+        advantages.size(0), -1, block_size
+    )
+    mask_blocks = _pad_last_dim_to_multiple(mask, block_size).reshape(mask.size(0), -1, block_size)
+
+    block_old_log_prob = old_blocks.sum(dim=-1)
+    block_log_prob = log_blocks.sum(dim=-1)
+    block_counts = mask_blocks.sum(dim=-1).clamp(min=1.0)
+    block_mask = mask_blocks.sum(dim=-1) / float(block_size)
+
+    block_advantage_sum = adv_blocks.sum(dim=-1)
+    block_advantage_mean = block_advantage_sum / block_counts
+    if block_advantage_mode == "sum":
+        block_advantages = block_advantage_sum
+    elif block_advantage_mode == "mean":
+        block_advantages = block_advantage_mean
+    else:
+        lam = float(block_mix_lambda)
+        block_advantages = (1.0 - lam) * block_advantage_sum + lam * block_advantage_mean
+
+    return block_old_log_prob, block_log_prob, block_advantages, block_mask
